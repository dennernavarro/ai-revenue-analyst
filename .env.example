# --- LLM access (Stage 2+; not needed for Stage 0/1) ---
# The default model goes through OpenRouter (https://openrouter.ai/keys):
OPENROUTER_API_KEY=

# Pick any model — the prefix decides the provider and which key is needed:
#   openrouter:<vendor>/<model>   e.g. openrouter:anthropic/claude-haiku-4.5
#   anthropic:<model>             needs ANTHROPIC_API_KEY
#   ollama:<model>                local, no key

# --- Optional: LangSmith tracing (everything works without it) ---
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
